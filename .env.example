# Database MySQL Connection
DATABASE_URL="mysql://root:root@localhost:3306/pivotassist"

# JWT & Session Secret
JWT_SECRET="change_me_in_production"

# Next.js Public & App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Password recovery delivery. In local development, the reset link is returned for testing when these are empty.
RESEND_API_KEY=""
EMAIL_FROM=""

# Free-first defaults. Optional local providers can be enabled later.
FREE_AI_MODE="heuristic"
OLLAMA_BASE_URL="http://localhost:11434"
REDIS_URL=""
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"
# LIVEKIT_URL="ws://127.0.0.1:7880"
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="secret"

# Optional Gemini integration (keep the key only in .env.local; never commit a live key)
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.6-flash"

# Optional Tesseract OCR for scanned resume images
TESSERACT_PATH=""

# Interview TTS: Google Translate TTS (cloud, cùng kiểu D:\TTS_KURO). Không cần GPU local / voice pack Windows.
# Endpoint nội bộ: GET /api/tts/google (cần đăng nhập). Unofficial, có thể bị Google chặn/rate-limit.

# Billing: vietqr (default) creates PENDING invoices. Use free-local only for lab activation without money.
BILLING_MODE="vietqr"
BILLING_BANK_BIN=""
# URL/path of the bank QR image shown during manual payment. No dynamic QR is generated.
BILLING_STATIC_QR_URL=""
BILLING_ACCOUNT_NO=""
BILLING_ACCOUNT_NAME=""

# Optional MoMo (leave empty = not configured; checkout fails clearly and never auto-PAID)
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT=""
MOMO_REDIRECT_URL="http://localhost:3000/services"
MOMO_IPN_URL="http://localhost:3000/api/billing/momo/ipn"
